{
  "name": "doorman",
  "version": "0.1.0",
  "description": "No repro, no entry: a maintainer agent that reproduces issues and checks PR claims inside locked-down Fly.io Sprites.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "doorman": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.87",
    "@fly/sprites": "0.2.4",
    "@octokit/rest": "22.0.1",
    "@pinecone-database/pinecone": "9.2.0",
    "@typesafe-ai/sdk": "0.7.0",
    "ai": "7.0.166",
    "box-node-sdk": "10.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "basic-ftp": "6.2.6"
  }
}
